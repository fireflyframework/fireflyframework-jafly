<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.fireflyframework</groupId>
    <artifactId>fireflyframework-jafly</artifactId>
    <version>26.10.17-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Jafly - Java Framework Reactor</name>
    <description>Unified Java framework build. Consumers use fireflyframework-parent or fireflyframework-bom.</description>
    <modules>
        <module>build/bom</module>
        <module>build/parent</module>
        <module>modules/agentic-bridge</module>
        <module>modules/backoffice</module>
        <module>modules/cache</module>
        <module>modules/cache-hazelcast</module>
        <module>modules/cache-jcache</module>
        <module>modules/cache-postgres</module>
        <module>modules/cache-redis</module>
        <module>modules/callbacks</module>
        <module>modules/client</module>
        <module>modules/config-server</module>
        <module>modules/cqrs</module>
        <module>modules/ecm</module>
        <module>modules/ecm-esignature-adobe-sign</module>
        <module>modules/ecm-esignature-docusign</module>
        <module>modules/ecm-esignature-logalty</module>
        <module>modules/ecm-storage-aws</module>
        <module>modules/ecm-storage-azure</module>
        <module>modules/eda</module>
        <module>modules/eda-kafka</module>
        <module>modules/eda-postgres</module>
        <module>modules/eda-rabbitmq</module>
        <module>modules/eventsourcing</module>
        <module>modules/kernel</module>
        <module>modules/notifications</module>
        <module>modules/notifications-firebase</module>
        <module>modules/notifications-resend</module>
        <module>modules/notifications-sendgrid</module>
        <module>modules/notifications-twilio</module>
        <module>modules/observability</module>
        <module>modules/orchestration</module>
        <module>modules/plugins</module>
        <module>modules/r2dbc</module>
        <module>modules/rule-engine</module>
        <module>modules/security-adapter-cerbos</module>
        <module>modules/security-adapter-opa</module>
        <module>modules/security-adapter-openfga</module>
        <module>modules/security-adapter-r2dbc</module>
        <module>modules/security-adapter-vault</module>
        <module>modules/security-api</module>
        <module>modules/security-authorization-server</module>
        <module>modules/security-bff</module>
        <module>modules/security-core</module>
        <module>modules/security-idp</module>
        <module>modules/security-idp-aws-cognito</module>
        <module>modules/security-idp-azure-ad</module>
        <module>modules/security-idp-internal-db</module>
        <module>modules/security-idp-keycloak</module>
        <module>modules/security-method-policy</module>
        <module>modules/security-oauth2-client</module>
        <module>modules/security-resource-server</module>
        <module>modules/security-spi</module>
        <module>modules/security-test</module>
        <module>modules/security-webflux</module>
        <module>modules/starter-application</module>
        <module>modules/starter-core</module>
        <module>modules/starter-data</module>
        <module>modules/starter-domain</module>
        <module>modules/utils</module>
        <module>modules/validators</module>
        <module>modules/web</module>
        <module>modules/webhooks</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
                <version>3.1.4</version>
                <configuration><skip>true</skip></configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>maven-central</id>
            <build><plugins><plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration><skipPublishing>true</skipPublishing></configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
