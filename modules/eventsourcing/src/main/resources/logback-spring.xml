<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Shared Firefly observability logging configuration -->
    <include resource="logback-firefly.xml"/>

    <!-- Event Sourcing property definitions -->
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="eventsourcing"/>
    <property name="LOG_PATH" value="${LOG_PATH:-${java.io.tmpdir:-/tmp}/logs}"/>
    <property name="LOG_FILE" value="${LOG_FILE:-${LOG_PATH}/eventsourcing}"/>

    <!-- Logger configurations specific to event sourcing -->
    <logger name="org.fireflyframework.eventsourcing.store" level="INFO"/>
    <logger name="org.fireflyframework.eventsourcing.aggregate" level="INFO"/>
    <logger name="org.fireflyframework.eventsourcing.publisher" level="INFO"/>
    <logger name="org.fireflyframework.eventsourcing.transaction" level="INFO"/>
    <logger name="org.fireflyframework.eventsourcing.snapshot" level="INFO"/>
    <logger name="org.fireflyframework.eventsourcing.projection" level="INFO"/>
    <logger name="org.fireflyframework.eventsourcing.outbox" level="INFO"/>

    <!-- R2DBC query logging (set to DEBUG to see SQL queries) -->
    <logger name="io.r2dbc.postgresql.QUERY" level="INFO"/>
    <logger name="io.r2dbc.postgresql.PARAM" level="INFO"/>
    <logger name="org.springframework.data.r2dbc" level="INFO"/>
    <logger name="io.r2dbc.pool" level="INFO"/>

    <!-- Root logger - uses shared FIREFLY_ASYNC appender from logback-firefly.xml -->
    <root level="INFO">
        <appender-ref ref="FIREFLY_ASYNC"/>
    </root>

    <!-- Profile-specific configurations -->
    <springProfile name="dev,local">
        <logger name="org.fireflyframework.eventsourcing" level="DEBUG"/>
        <logger name="io.r2dbc.postgresql.QUERY" level="DEBUG"/>
    </springProfile>

    <springProfile name="test">
        <logger name="org.fireflyframework.eventsourcing" level="DEBUG"/>
    </springProfile>

    <springProfile name="prod,production">
        <logger name="org.fireflyframework.eventsourcing" level="INFO"/>
    </springProfile>
</configuration>
